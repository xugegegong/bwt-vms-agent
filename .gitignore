# ── 凭据与密钥（绝对不要提交）────────────────────────────
.env
*.env
*.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
id_rsa*
*_rsa
*credentials*
*secret*

# 本地凭据（各人自己存真实连接信息，不入库）
local/
local.*

# ── 数据库备份 / 快照 / 数据 dump（含真实船舶数据，且体积大）──
#   注意：带斜杠的模式是"锚定根目录"的，要写 `名字/` 才会在任意层级匹配；
#   写成 `*/名字/` 只能匹配根下一层，深层目录会漏（踩过）
snapshots/
实船基准/
*_backup/
*.dump
*.sql.gz

# ── 套件自测材料（★ 不进仓库）────────────────────────
# 理由：它测的就是本仓库。放进仓库 = 被测智能体能直接翻到答案，测试就失效了。
# 这些材料留在本地由 F 保管；要跑测试就用一份「不含 testing/ 的副本」（如从 GitHub 克隆）。
testing/

# ── 中间产物 ─────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/
node_modules/
*.log

# ── 临时 ────────────────────────────────────────────
.DS_Store
Thumbs.db
